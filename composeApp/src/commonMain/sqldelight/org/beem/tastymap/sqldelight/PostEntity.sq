CREATE TABLE PostEntity (
    postId INTEGER NOT NULL PRIMARY KEY,
    userId INTEGER NOT NULL,
    photoUrls TEXT NOT NULL, -- Virgülle ayrılmış fotoğraf URL'leri (örn: "url1,url2,url3")
    isPinned INTEGER NOT NULL DEFAULT 0,

    -- Detay Alanları
    explanation TEXT,
    numberOfLikes INTEGER NOT NULL DEFAULT 0,
    commentCount INTEGER NOT NULL DEFAULT 0,
    isLiked INTEGER NOT NULL DEFAULT 0,
    commentEnabled INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER,
    updateDate INTEGER,

    -- Sahibinin Anlık Bilgileri
    username TEXT,
    profilePhotoUrl TEXT,

    -- Embedded Mekan Bilgileri
    placeId TEXT,
    placeName TEXT,
    categories TEXT,
    city TEXT,
    district TEXT,
    neighbourhood TEXT,
    latitude REAL,
    longitude REAL,
    averagePoint REAL,

    -- Cache Yönetimi
    page INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL
);

-- Index'ler
CREATE INDEX idx_post_user_pinned ON PostEntity(userId, isPinned DESC, createdAt DESC);
CREATE INDEX idx_post_updatedAt ON PostEntity(updatedAt DESC);

-- ==================== QUERIES ====================

-- 1. Kullanıcının Grid Postlarını Getir
getUserGridPosts:
SELECT postId, photoUrls, isPinned
FROM PostEntity
WHERE userId = :userId
ORDER BY isPinned DESC, createdAt DESC;

-- 2. Post Detayını Getir
getPostDetailById:
SELECT * FROM PostEntity WHERE postId = :postId;

-- 3. Ortak Kontrol: Post Var mı?
checkPostExists:
SELECT COUNT(postId) FROM PostEntity WHERE postId = :postId;

-- ==================== GRID ISLEMLERI ====================

-- 4. Grid Ekleme
insertGridPost:
INSERT INTO PostEntity (postId, userId, photoUrls, isPinned, page, updatedAt)
VALUES (:postId, :userId, :photoUrls, :isPinned, :page, :updatedAt);

-- 5. Grid Güncelleme
updateGridPost:
UPDATE PostEntity
SET userId = :userId,
    photoUrls = :photoUrls,
    isPinned = :isPinned,
    page = :page,
    updatedAt = :updatedAt
WHERE postId = :postId;

-- ==================== DETAY ISLEMLERI ====================

-- 6. Detay Ekleme
insertPostDetail:
INSERT INTO PostEntity (
    postId, userId, photoUrls, isPinned, explanation, numberOfLikes,
    commentCount, isLiked, commentEnabled, createdAt, updateDate, username,
    profilePhotoUrl, placeId, placeName, categories, city, district,
    neighbourhood, latitude, longitude, averagePoint, page, updatedAt
) VALUES (
    :postId, :userId, :photoUrls, :isPinned, :explanation, :numberOfLikes,
    :commentCount, :isLiked, :commentEnabled, :createdAt, :updateDate, :username,
    :profilePhotoUrl, :placeId, :placeName, :categories, :city, :district,
    :neighbourhood, :latitude, :longitude, :averagePoint, :page, :updatedAt
);

-- 7. Detay Güncelleme
updatePostDetail:
UPDATE PostEntity
SET photoUrls = COALESCE(:photoUrls, photoUrls),
    explanation = COALESCE(:explanation, explanation),
    numberOfLikes = :numberOfLikes,
    commentCount = :commentCount,
    isLiked = :isLiked,
    commentEnabled = :commentEnabled,
    updateDate = COALESCE(:updateDate, updateDate),
    username = COALESCE(:username, username),
    profilePhotoUrl = COALESCE(:profilePhotoUrl, profilePhotoUrl),
    placeId = COALESCE(:placeId, placeId),
    placeName = COALESCE(:placeName, placeName),
    categories = COALESCE(:categories, categories),
    city = COALESCE(:city, city),
    district = COALESCE(:district, district),
    neighbourhood = COALESCE(:neighbourhood, neighbourhood),
    latitude = COALESCE(:latitude, latitude),
    longitude = COALESCE(:longitude, longitude),
    averagePoint = COALESCE(:averagePoint, averagePoint),
    updatedAt = :updatedAt
WHERE postId = :postId;

-- ==================== DIGER ISLEMLER ====================

-- 8. Beğeni Toggle
toggleLikeLocal:
UPDATE PostEntity
SET isLiked = CASE WHEN isLiked = 1 THEN 0 ELSE 1 END,
    numberOfLikes = CASE WHEN isLiked = 1 THEN MAX(0, numberOfLikes - 1) ELSE numberOfLikes + 1 END,
    updatedAt = :updatedAt
WHERE postId = :postId;

-- 9. Pin Toggle
togglePinLocal:
UPDATE PostEntity
SET isPinned = CASE WHEN isPinned = 1 THEN 0 ELSE 1 END,
    updatedAt = :updatedAt
WHERE postId = :postId;

-- 10. Post Sil
deletePostById:
DELETE FROM PostEntity WHERE postId = :postId;

-- 11. Kullanıcının Tüm Postlarını Sil
deletePostsByUserId:
DELETE FROM PostEntity WHERE userId = :userId;

-- 12. TRIM / CLEANUP (Veritabanı Şişmesini Önleme)
trimOldPosts:
DELETE FROM PostEntity
WHERE postId NOT IN (
    SELECT postId FROM PostEntity
    ORDER BY updatedAt DESC
    LIMIT 100
);

-- 13. Tüm Önbelleği Temizle (Logout)
clearAllPosts:
DELETE FROM PostEntity;